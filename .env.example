# Durable cloud store — add these in Vercel → Storage → Create KV
# or Vercel → Settings → Environment Variables
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Mail (tried in this order — none of these is Twilio)
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
NOTIFY_FROM=

# Texts (Textbelt, then carrier email-to-text). Twilio is optional last resort only.
TEXTBELT_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
